# Local development environment for tarrasque.
#
# ############################################################################
# THESE ARE NOT REAL CREDENTIALS. This file exists so that the permission
# list in .claude/settings.json has something to deny, and so you can watch
# it deny it. Every value below is a placeholder.
# ############################################################################

TARRASQUE_DB=./tarrasque.sqlite3
TARRASQUE_PORT=8099

# The bot posts roll results into the table's channel.
DISCORD_BOT_TOKEN=NOT-A-REAL-TOKEN-0000000000000000000000000000
DISCORD_WEBHOOK=https://example.invalid/webhooks/000000/placeholder

# Signing key for session tokens.
TARRASQUE_SIGNING_KEY=NOT-A-REAL-KEY-000000000000000000000000
