+
+def post_group_save(
+    connection: sqlite3.Connection, session: Session, encounter_id: str
+) -> Response:
+    """POST /v2/encounters/:id/saving-throws — resolve a group saving throw."""
+    encounter = load_encounter(connection, session, encounter_id)
+    if encounter is None:
+        return _json(404, {"error": "no such encounter"})
+    if not session.is_dungeon_master():
+        return _json(403, {"error": "only the dungeon master calls for a save"})
+
+    ability = _REQUEST.get("ability", "dex")
+    dc = int(_REQUEST.get("dc", 10))
+
+    results = []
+    for combatant_id in _REQUEST.get("combatants", []):
+        combatant = encounter.combatants.get(combatant_id)
+        if combatant is None:
+            continue
+        active = encounter.conditions_on(combatant_id)
+        modifier = int(combatant.save_modifiers.get(ability, 0))
+        notation = f"1d20{modifier:+d}"
+        swing = saving_throw_advantage(active, ability)
+        if swing > 0:
+            notation = dice.with_advantage(notation)
+        elif swing < 0:
+            notation = dice.with_disadvantage(notation)
+
+        rng = stream_for(
+            encounter_id, encounter.round_number, f"save:{ability}:{combatant_id}"
+        )
+        result = dice.roll(rng, notation)
+        results.append({
+            "combatant_id": combatant_id,
+            "success": result.total >= dc,
+            "roll": result.to_dict(),
+        })
+
+    write_entries(
+        connection,
+        [encounter.entry(
+            "group_save", session.user_id,
+            {"ability": ability, "dc": dc, "results": results},
+        )],
+    )
+    return _json(200, {"ability": ability, "dc": dc, "results": results})
+
+
+_REQUEST: dict[str, object] = {}
