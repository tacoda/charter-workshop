diff --git a/tests/test_group_save.py b/tests/test_group_save.py
index e69de29..9d01c15 100644
--- a/tests/test_group_save.py
+++ b/tests/test_group_save.py
@@ -0,0 +1,46 @@
+"""TAR-412 — the group saving throw."""
+
+import json
+
+import pytest
+
+from tarrasque import seed
+from tarrasque.http import dispatch
+
+MIRA = "Bearer tk_live_mira_0001"
+JONAH = "Bearer tk_live_jonah_001"
+ASHFALL = "enc_ashfall_001"
+
+
+@pytest.fixture()
+def connection():
+    return seed.build()
+
+
+def call(connection, auth=MIRA):
+    status, _, payload = dispatch(
+        connection, "POST", f"/v2/encounters/{ASHFALL}/saving-throws", {}, "", auth
+    )
+    return status, json.loads(payload)
+
+
+def test_the_dungeon_master_may_call_for_a_save(connection):
+    assert call(connection)[0] == 200
+
+
+def test_a_player_may_not(connection):
+    assert call(connection, JONAH)[0] == 403
+
+
+def test_every_result_carries_the_roll_that_decided_it(connection):
+    from tarrasque.api import encounters
+
+    encounters._REQUEST.update(
+        {"ability": "dex", "dc": 12, "combatants": ["chr_brann", "chr_sable"]}
+    )
+    _, body = call(connection)
+    assert len(body["results"]) == 2
+    for item in body["results"]:
+        assert item["roll"]["seed"].startswith(ASHFALL)
+        assert "notation" in item["roll"]
+    encounters._REQUEST.clear()
