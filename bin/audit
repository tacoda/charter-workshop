#!/usr/bin/env python3
"""The retrofit audit: find the signals in this repo that lie.

    bin/audit

Deleting a false signal is worth more than adding a true rule, because the
codebase outranks the charter. Run this before writing a line of CLAUDE.md.
Nothing here deletes anything — the judgement is yours.
"""

from __future__ import annotations

import re
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

SUSPECT_COMMENT = re.compile(
    r"#\s*(?:NOTE|TODO|FIXME|HACK|XXX|WARNING)\b.*", re.I
)
CLAIMS = re.compile(
    r"\b(?:all|every|never|always|no\s+\w+\s+(?:calls?|uses?))\b", re.I
)


def sources() -> list[Path]:
    return sorted(
        path
        for path in ROOT.rglob("*.py")
        if ".git" not in path.parts and "levers" not in path.parts
    )


def documents() -> list[Path]:
    return sorted(
        path
        for path in ROOT.rglob("*.md")
        if ".git" not in path.parts
        and "levers" not in path.parts
        and "tickets" not in path.parts
    )


def last_touched(path: Path) -> str:
    out = subprocess.run(
        ["git", "log", "-1", "--format=%ar", "--", str(path)],
        cwd=ROOT, capture_output=True, text=True, check=False,
    ).stdout.strip()
    return out or "uncommitted"


def main() -> int:
    print("  1 · comments that make a claim about the whole codebase")
    print("      each one outranks anything you write in CLAUDE.md\n")
    for path in sources():
        text = path.read_text(encoding="utf-8")
        for number, line in enumerate(text.splitlines(), 1):
            found = SUSPECT_COMMENT.search(line)
            if found and CLAIMS.search(found.group(0)):
                relative = path.relative_to(ROOT)
                print(f"      {relative}:{number}")
                print(f"        {found.group(0).strip()[:100]}")

    print("\n  2 · prose describing the architecture")
    print("      check each against the code before you trust any of it\n")
    for path in documents():
        relative = path.relative_to(ROOT)
        words = len(path.read_text(encoding="utf-8").split())
        print(f"      {str(relative):<44} {words:>5} words   {last_touched(path)}")

    print("\n  3 · modules the checks deliberately do not govern")
    print("      out-of-scope is a policy; make sure the policy is written down\n")
    pyproject = (ROOT / "pyproject.toml").read_text(encoding="utf-8")
    for number, line in enumerate(pyproject.splitlines(), 1):
        if "ignore_errors" in line or 'per-file-ignores' in line or '= ["ALL"]' in line:
            print(f"      pyproject.toml:{number}  {line.strip()[:90]}")

    print("\n  4 · the working affordances for things the charter forbids")
    print("      a function that does the wrong thing is louder than a rule\n")
    for path in sources():
        text = path.read_text(encoding="utf-8")
        for number, line in enumerate(text.splitlines(), 1):
            if re.match(r"\s*def (update_log|delete_log|reset_session)", line):
                print(f"      {path.relative_to(ROOT)}:{number}  {line.strip()[:80]}")

    print("\n  Nothing was deleted. Decide which of these is a lie, and remove it.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
