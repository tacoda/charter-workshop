#!/usr/bin/env python3
"""Score the working tree against the charter's checks.

    bin/score --ticket TAR-412            # score and print
    bin/score --ticket TAR-412 --json     # machine-readable
    bin/score --ticket TAR-412 --no-verify

Nine checks. Eight are decidable and run in `charter/check.py`. The ninth is
not, and prints `?` until a reviewer fills it in. That hole is not an
oversight; it is the part of the charter no predicate can hold, and the
scorecard says so out loud rather than pretending the column is green.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from tools.scorecard import render, score  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(prog="bin/score")
    parser.add_argument("--ticket", default="TAR-412")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--no-verify", action="store_true",
                        help="skip `make verify` (faster; C8 reports pass)")
    args = parser.parse_args()

    card = score(args.ticket, run_verify=not args.no_verify)
    print(json.dumps(card, indent=2) if args.json else render(card))
    return 0


if __name__ == "__main__":
    sys.exit(main())
